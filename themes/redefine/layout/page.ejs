<%- partial('components/header/progress-bar') %>
<% if (theme.global.preloader === true || theme.global.preloader.enable === true) { %>
<%- partial('components/header/preloader') %>
<% } %>
<main class="page-container" id="swup">

	<% if (theme.home_banner.enable === true && is_home() && !page.prev) { %>
	<%- partial('pages/home/home-banner') %>
	<% } else if (theme.home_banner.enable === true && is_home() && page.prev && theme.home_banner.style === "fixed") { %>
	<%- partial('pages/home/home-background') %>
	<% } %>

	<%
	/* ---------------------------------------------------------------------
	   页面横幅带（非主页）—— 对应 theme.page_banner 配置
	   --------------------------------------------------------------------- */
	var pbCfg  = theme.page_banner || {};
	var pbImgs = pbCfg.images || {};
	var pbKey  = is_tag()      ? 'tags'
	           : is_category() ? 'categories'
	           : is_archive()  ? 'archives'
	           : (page.type || page.layout || 'default');
	var pbImg  = pbImgs[pbKey] || pbImgs['default'];
	var pbOn   = (pbCfg.enable !== false) && !!pbImg && !is_home();

	/* 本页是否处于「横幅带 + 纯色底」布局（主页也算，只要首页 banner 开启） */
	var hasBanner = is_home()
	    ? (theme.home_banner.enable === true && !page.prev)
	    : pbOn;
	%>

	<% if (pbOn) { %>
	<%- partial('components/page-banner') %>
	<% } %>

	<div class="main-content-container flex flex-col justify-between min-h-dvh<%= hasBanner ? ' has-page-banner' : '' %>">
		<div class="main-content-header">
			<%- partial('components/header/navbar') %>
		</div>

		<div class="main-content-body transition-fade-up">
			<% if (is_home() && theme.home.sidebar.enable === true && theme.home.sidebar.position === "left") { %>
			<%- partial('pages/home/home-sidebar') %>
			<% } %>

			<div class="main-content">
				<%- partial(getPagePartialPath(page)) %>
			</div>

			<% if (is_home() && theme.home.sidebar.enable === true && theme.home.sidebar.position === "right") { %>
			<%- partial('pages/home/home-sidebar') %>
			<% } %>
		</div>

		<div class="main-content-footer">
			<%- partial('components/footer/footer') %>
		</div>
	</div>

	<% if (is_post()) { %>
	<div class="post-tools">
		<%- partial('pages/post/post-tools') %>
	</div>
	<% } %>

	<div class="right-side-tools-container">
		<%- partial('utils/side-tools') %>
	</div>

	<%- partial('utils/image-viewer') %>

	<% if (theme.navbar.search.enable) { %>
	<%- partial('utils/local-search') %>
	<% } %>

	<%#
	   navbar 变实时机
	   主题自带的 navbarShrink.js 在 scrollTop > navbarHeight(70px) 就加 .navbar-shrink，
	   导致导航栏刚压上横幅图就变实底。这里另设一个更晚的阈值：
	   横幅底部越过导航栏底边时，才给 body 加 .navbar-solid。
	%>
	<script data-swup-reload-script>
	(function () {
		var threshold = 0;

		function recompute() {
			var banner = document.querySelector('.home-banner-container') ||
			             document.querySelector('.page-banner');
			var nav = document.querySelector('.main-content-header');
			var bh = banner ? banner.getBoundingClientRect().height : 0;
			var nh = nav ? nav.offsetHeight : 70;
			// 横幅底部 - 导航栏高度 = 导航栏完全离开横幅的时刻
			threshold = Math.max(nh, bh - nh);
		}

		function onScroll() {
			if (!threshold) recompute();
			document.body.classList.toggle('navbar-solid', window.scrollY >= threshold);
		}

		function boot() { recompute(); onScroll(); }

		if (document.readyState === 'complete') boot();
		else window.addEventListener('load', boot, { once: true });
		window.addEventListener('resize', boot);
		window.addEventListener('scroll', onScroll, { passive: true });
		window.addEventListener('redefine:page:refresh', boot);
	})();
	</script>

</main>

<% if (theme.global.single_page !== false) { %>
<%- partial('components/swup') %>
<% } %>