<style>
.credits-wrapper {
  position: relative;
}
.credits-page {
  max-width: 720px;
  margin: 0 auto;
  padding: 2rem 1.5rem 4rem;
  text-align: center;
  position: relative;
}
.credits-glow {
  position: absolute;
  top: -20%;
  left: 50%;
  transform: translateX(-50%);
  width: 400px;
  height: 400px;
  border-radius: 50%;
  background: radial-gradient(circle, var(--primary-color) 0%, transparent 70%);
  opacity: 0.04;
  pointer-events: none;
}
.credits-header {
  padding: 4rem 0 2rem;
}
.credits-heart {
  font-size: 2.5rem;
  color: var(--second-text-color);
  opacity: 0.5;
  margin-bottom: 0.5rem;
  line-height: 1;
}
.credits-title {
  font-size: 2.5rem;
  font-weight: 300;
  color: var(--first-text-color);
  letter-spacing: 0.15em;
  margin-bottom: 0.6rem;
}
@media (max-width: 640px) {
  .credits-title { font-size: 1.8rem; }
}
.credits-subtitle {
  font-size: 0.9rem;
  color: var(--third-text-color);
  font-weight: 300;
  letter-spacing: 0.08em;
}
@media (max-width: 640px) {
  .credits-subtitle { font-size: 0.8rem; }
}
.credits-divider {
  width: 30px;
  height: 1px;
  margin: 1.5rem auto;
  background: var(--border-color);
  opacity: 0.5;
}
.credits-body {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}
.credits-card {
  border: 1px solid var(--border-color);
  border-radius: 12px;
  padding: 1.5rem;
  background: var(--background-color);
}
.credits-card-header {
  font-size: 0.9rem;
  font-weight: 500;
  color: var(--second-text-color);
  letter-spacing: 0.1em;
  margin-bottom: 1.5rem;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.4rem;
}
.credits-card-icon {
  font-size: 0.7rem;
  opacity: 0.5;
}
.credits-empty {
  padding: 2rem 0 1rem;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.credits-empty-icon {
  font-size: 2.5rem;
  color: var(--third-text-color);
  opacity: 0.2;
  letter-spacing: 0.4em;
  line-height: 1;
  margin-bottom: 0.5rem;
}
.credits-empty-text {
  font-size: 0.95rem;
  color: var(--third-text-color);
  font-weight: 400;
}
.credits-empty-hint {
  font-size: 0.78rem;
  color: var(--third-text-color);
  opacity: 0.5;
  margin-top: 0.5rem;
  font-weight: 300;
}
.credits-patrons-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 1.25rem;
  padding: 0.5rem 0;
}
.credits-patron-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: 0.6rem;
  padding: 1.8rem 1.8rem 1.5rem;
  border-radius: 16px;
  border: 1px solid var(--border-color);
  background: var(--background-color);
  width: 170px;
  flex-shrink: 0;
  transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s;
}
.credits-patron-card:hover {
  transform: translateY(-3px);
  box-shadow: 0 6px 24px var(--shadow-color-1);
  border-color: var(--primary-color);
}
.credits-patron-card .credits-patron-avatar {
  width: 72px;
  height: 72px;
  border-radius: 50%;
  overflow: hidden;
  flex-shrink: 0;
  border: 2px solid var(--border-color);
}
.credits-patron-card .credits-patron-avatar img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
.credits-patron-card-name {
  font-size: 1.05rem;
  font-weight: 600;
  color: var(--first-text-color);
  letter-spacing: 0.04em;
  margin-top: 0.15rem;
  white-space: nowrap;
}
.credits-patron-card-bio {
  font-size: 0.85rem;
  color: var(--third-text-color);
  font-weight: 300;
  line-height: 1.4;
  white-space: nowrap;
}
.credits-footer {
  margin-top: 2.5rem;
  padding-top: 1.5rem;
}
.credits-footer-text {
  font-size: 0.75rem;
  color: var(--third-text-color);
  opacity: 0.35;
  font-style: italic;
  letter-spacing: 0.05em;
}
</style>
<div class="credits-wrapper">
  <div class="linux-corner-deco">
    <div class="linux-dot linux-dot-red"></div>
    <div class="linux-dot linux-dot-yellow"></div>
    <div class="linux-dot linux-dot-green"></div>
    <span class="linux-label">~/credits</span>
  </div>
  <div class="credits-page">
    <!-- 背景光晕 -->
    <div class="credits-glow"></div>
    <!-- 头部 -->
    <div class="credits-header">
      <div class="credits-heart">♥</div>
      <h1 class="credits-title">致谢</h1>
      <p class="credits-subtitle">感谢每一位让这个博客存在的人</p>
      <div class="credits-divider"></div>
    </div>
    <!-- 赞助者列表 -->
    <div class="credits-body">
      <div class="credits-card">
        <div class="credits-card-header">
          <span class="credits-card-icon">✦</span>
          赞助朋友
        </div>
        <%
        var patrons = [
          { name: 'lzx',  img: '/images/lzx.jpg',  bio: '来去从容，轩然不惊' },
          { name: 'Puppet',  img: '/images/puppet.jpg',  bio: '灯火阑珊处' },
          { name: '任怀学',  img: '/images/rhx.jpg',  bio: '超脱世俗者' },
          { name: '😠',  img: '/images/ds.jpg',  bio: 'ds只是不语' },
          { name: '溪流亭馨',  img: '/images/溪流亭馨.jpg',  bio: '高手已经在打瓦了' },
          { name: '忆佳时',  img: '/images/yjs.jpg',  bio: '土豆会证明一切' },
          { name: '指北瓜',  img: '/images/zbg.jpg',  bio: '预备酒精' },
          { name: '深椿',  img: '/images/sc.jpg',  bio: '超影2400的卡卡大帝' },
          { name: '歪彼得',  img: '/images/wbd.jpg',  bio: '菜就多练' },
        ];
        %>
        <div class="credits-empty" style="display: <%= patrons.length === 0 ? '' : 'none' %>;">
          <div class="credits-empty-icon">⋯</div>
          <p class="credits-empty-text">暂时没有赞助记录</p>
          <p class="credits-empty-hint">如果你觉得这个博客有价值，欢迎赞助支持</p>
        </div>
        <div class="credits-patrons-grid">
          <% patrons.forEach(function(p) { %>
            <div class="credits-patron-card">
              <div class="credits-patron-avatar">
                <img src="<%= p.img %>" alt="<%= p.name %>">
              </div>
              <div class="credits-patron-card-name"><%= p.name %></div>
              <div class="credits-patron-card-bio"><%= p.bio %></div>
            </div>
          <% }); %>
        </div>
      </div>
    </div>
    <!-- 底部 -->
    <div class="credits-footer">
      <p class="credits-footer-text">每一份支持都值得被记住</p>
    </div>
  </div>
</div>