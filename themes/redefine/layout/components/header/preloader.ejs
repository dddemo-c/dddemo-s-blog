<style>
:root {
  --ld-bg: #fafafa;
  --ld-fg: #1a1a2e;
}
@media (prefers-color-scheme: dark) {
  :root { --ld-bg: #0a0c11; --ld-fg: #e0def4; }
}

/* ============================================================================
   加载遮罩
   「渐渐输出」：六个字母**一个接一个**出现，每个走完再出下一个
   （间隔 0.45s ≈ 动画时长 0.5s，几乎没有重叠，所以能清楚看到先后顺序）
   风格参考 Apple：不用位移弹跳，用极轻的「模糊消散 + 淡入」，缓动 expo-out
   ============================================================================ */
.loader-overlay {
  position: fixed; inset: 0;
  z-index: 9999;
  display: flex; align-items: center; justify-content: center;
  background: var(--ld-bg);
  color: var(--ld-fg);
  opacity: 1;
  transition: opacity 1.05s cubic-bezier(0.16, 1, 0.3, 1);
  will-change: opacity;
}
.loader-overlay.hidden {
  opacity: 0;
  pointer-events: none;
}

.ld-inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2.1rem;
  transform: translateY(-3vh);
  transition: transform 1.05s cubic-bezier(0.16, 1, 0.3, 1),
              opacity 0.9s cubic-bezier(0.16, 1, 0.3, 1);
}
.loader-overlay.hidden .ld-inner {
  transform: translateY(-5vh) scale(1.015);
  opacity: 0;
}

/* ---------- 站名：逐字「渐渐输出」 ---------- */
.ld-word {
  display: flex;
  align-items: baseline;
}
.ld-word span {
  display: inline-block;
  font-family: 'Chillax-Variable', 'Geist Variable', -apple-system, sans-serif;
  font-size: clamp(1.75rem, 3.8vw, 2.8rem);
  font-weight: 600;
  letter-spacing: 0.3em;
  text-transform: uppercase;
  color: var(--ld-fg);

  opacity: 0;
  filter: blur(7px);
  /* 动画时长 0.5s，与 0.45s 的间隔几乎不重叠 -> 逐字顺序清晰可见 */
  animation: ldEmerge 0.5s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}
@keyframes ldEmerge {
  from { opacity: 0; filter: blur(7px); }
  70%  { opacity: 0.85; }
  to   { opacity: 0.95; filter: blur(0); }
}

/* ---------- 细线：极慢生长，兼作进度 ---------- */
.ld-bar {
  position: relative;
  width: clamp(190px, 27vw, 330px);
  height: 1px;
  background: currentColor;
  opacity: 0.1;
  overflow: hidden;
}
.ld-bar i {
  position: absolute; inset: 0;
  background: currentColor;
  opacity: 0.65;
  transform: scaleX(0);
  transform-origin: left center;
}

/* ---------- 那句英文：最后浮现，与删格保持一致 ---------- */
.ld-phrase {
  max-width: min(76vw, 540px);
  text-align: center;
  font-size: 0.62rem;
  font-weight: 300;
  letter-spacing: 0.2em;
  line-height: 1.9;
  color: var(--ld-fg);
  opacity: 0;
  animation: ldPhraseIn 1.7s cubic-bezier(0.16, 1, 0.3, 1) 2.35s forwards;
}
@keyframes ldPhraseIn {
  from { opacity: 0; filter: blur(6px); }
  to   { opacity: 0.5; filter: blur(0); }
}

/* ---------- 计数器：极小、极淡，与字母同步浮现 ---------- */
.ld-count {
  font-family: 'Geist Mono', ui-monospace, SFMono-Regular, monospace;
  font-size: 0.62rem;
  font-weight: 400;
  letter-spacing: 0.34em;
  font-variant-numeric: tabular-nums;
  color: var(--ld-fg);
  opacity: 0;
  animation: ldFadeIn 1.4s cubic-bezier(0.16, 1, 0.3, 1) 1.6s forwards;
}
@keyframes ldFadeIn { to { opacity: 0.42 } }

/* ---------- 无障碍：偏好减少动效时取消模糊，只保留淡入 ---------- */
@media (prefers-reduced-motion: reduce) {
  .ld-phrase { animation: none; opacity: 0.5; filter: none; }
  /* 只去掉模糊与缩放这类可能引起不适的效果，
     保留"逐字淡入"的节奏 —— 规范允许纯透明度动画，
     全关掉会让加载动画变成一闪而过。 */
  .ld-word span { filter: none; }
  .loader-overlay.hidden .ld-inner { transform: translateY(-3vh); }
}
</style>

<div class="loader-overlay" id="loader">
  <div class="ld-inner">
    <div class="ld-word" aria-label="dddemo">
      <span style="animation-delay:0.00s">d</span><span style="animation-delay:0.45s">d</span><span style="animation-delay:0.90s">d</span><span style="animation-delay:1.35s">e</span><span style="animation-delay:1.80s">m</span><span style="animation-delay:2.25s">o</span>
    </div>
    <div class="ld-bar"><i id="ldBar"></i></div>
    <div class="ld-phrase">Between eternity and nothingness, I keep silent for you.</div>
    <div class="ld-count" id="ldCount">00</div>
  </div>

  <script>
  (function () {
    var loader = document.getElementById('loader');
    if (!loader) return;

    // 仅用于日志/调试；时长不再随它变化
    var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var bar   = document.getElementById('ldBar');
    var count = document.getElementById('ldCount');

    // 跟随站点已保存的主题
    try {
      var saved = localStorage.getItem('REDEFINE-THEME-STATUS');
      var dark = saved ? JSON.parse(saved).isDark
                       : (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches);
      if (dark) {
        document.documentElement.style.setProperty('--ld-bg', '#0a0c11');
        document.documentElement.style.setProperty('--ld-fg', '#e0def4');
      }
    } catch (e) {}

    // 加载期间锁定滚动
    document.documentElement.style.overflow = 'hidden';

    // 最后一个字：delay 2.25s + 动画 0.5s = 2.75s
    // 无论是否 reduce，都保持逐字输出的节奏（只去掉模糊）
    var WORD_DONE = 2750;

    var shown = 0, done = false, raf = null;
    var t0 = performance.now();
    var RISE = WORD_DONE;        // 进度与逐字输出同步走完
    var FLOOR = 6, CEIL = 88;

    function tick(now) {
      var elapsed = now - t0;
      var eased = Math.min(elapsed / RISE, 1);
      var curved = 1 - Math.pow(1 - eased, 2.2);
      var wordPct = FLOOR + curved * (CEIL - FLOOR);   // 由「逐字输出」的节奏决定

      /* ⚠️ 关键：资源加载完（done）不能立刻冲到 100，
         否则页面很快就绪时，字母还没出完遮罩就退场了。
         必须同时满足：资源已加载 + 逐字输出已完成。 */
      var canFinish = done && elapsed >= WORD_DONE;
      var target = canFinish ? 100 : wordPct;

      shown += (target - shown) * 0.09;
      if (target - shown < 0.4) shown = target;

      var p = Math.min(99.4, shown);
      if (bar)   bar.style.transform = 'scaleX(' + (p / 100) + ')';
      if (count) count.textContent = String(Math.round(p)).padStart(2, '0');

      if (!(canFinish && shown >= 99.3)) raf = requestAnimationFrame(tick);
      else finish();
    }

    var finished = false;
    function finish() {
      if (finished) return;
      finished = true;
      if (bar)   bar.style.transform = 'scaleX(1)';
      if (count) count.textContent = '100';
      if (raf) cancelAnimationFrame(raf);
      setTimeout(function () {
        loader.classList.add('hidden');
        document.documentElement.style.overflow = '';
        setTimeout(function () {
          if (loader && loader.parentNode) loader.parentNode.removeChild(loader);
        }, 1300);
      }, 600);
    }

    raf = requestAnimationFrame(tick);

    // ---- 触发：资源加载完成 ----
    function loaded() { done = true; }
    if (document.readyState === 'complete') setTimeout(loaded, 200);
    else window.addEventListener('load', function () { setTimeout(loaded, 200); });

    // 兜底：最长 8s
    setTimeout(function () { done = true; setTimeout(finish, 1500); }, 8000);
  })();
  </script>
</div>
