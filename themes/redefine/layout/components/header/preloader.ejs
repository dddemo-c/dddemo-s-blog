<style>
:root {
  --loader-bg: #fafafa;
  --loader-text: #1a1a2e;
}
@media (prefers-color-scheme: dark) {
  :root {
    --loader-bg: #0f0f1a;
    --loader-text: #e0def4;
  }
}

.loader-overlay {
  position: fixed; inset: 0;
  z-index: 9999;
  display: flex; flex-direction: column;
  align-items: center; justify-content: center;
  background: var(--loader-bg);
  transition: opacity 0.6s ease, visibility 0.6s ease;
}
.loader-overlay.hidden {
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
}

/* ---- Canvas particles ---- */
#loaderCanvas {
  position: absolute; inset: 0;
  width: 100%; height: 100%;
  pointer-events: none;
}

/* ---- Inner content ---- */
.loader-inner {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 28px;
}

/* ---- Geometric spinner: three rotating rings ---- */
.geo-spinner {
  position: relative;
  width: 64px; height: 64px;
}
.geo-spinner .ring {
  position: absolute; inset: 0;
  border: 2px solid transparent;
  border-radius: 50%;
}
.geo-spinner .ring:nth-child(1) {
  border-top-color: var(--loader-text);
  animation: spin1 1.2s cubic-bezier(.4,0,.2,1) infinite;
}
.geo-spinner .ring:nth-child(2) {
  inset: 6px;
  border-right-color: var(--loader-text);
  opacity: .5;
  animation: spin2 1.8s cubic-bezier(.4,0,.2,1) infinite;
}
.geo-spinner .ring:nth-child(3) {
  inset: 12px;
  border-bottom-color: var(--loader-text);
  opacity: .25;
  animation: spin3 2.4s cubic-bezier(.4,0,.2,1) infinite;
}
@keyframes spin1 { to { transform: rotate(360deg) } }
@keyframes spin2 { to { transform: rotate(-360deg) } }
@keyframes spin3 { to { transform: rotate(360deg) } }

/* ---- Brand text ---- */
.loader-brand {
  font-size: 1.6rem;
  font-weight: 500;
  letter-spacing: .15em;
  color: var(--loader-text);
  font-family: 'Chillax-Variable','Inter',sans-serif;
  text-transform: uppercase;
  opacity: .7;
}

/* ---- Fade-in for the whole content ---- */
.loader-inner {
  animation: lfadeIn 0.8s ease both;
}
@keyframes lfadeIn {
  from { opacity: 0; transform: translateY(8px) }
  to   { opacity: 1; transform: translateY(0) }
}
</style>

<div class="loader-overlay" id="loader">
  <canvas id="loaderCanvas"></canvas>
  <div class="loader-inner">
    <div class="geo-spinner">
      <div class="ring"></div>
      <div class="ring"></div>
      <div class="ring"></div>
    </div>
    <div class="loader-brand">dddemo</div>
  </div>

  <script>
  (function() {
    var loader = document.getElementById('loader');
    var canvas = document.getElementById('loaderCanvas');
    var ctx = canvas.getContext('2d');
    var W, H;

    function resize() {
      W = canvas.width = window.innerWidth;
      H = canvas.height = window.innerHeight;
    }
    resize();
    window.addEventListener('resize', resize);

    // Determine colors based on theme
    function isDark() {
      try {
        var saved = localStorage.getItem('REDEFINE-THEME-STATUS');
        if (saved) return JSON.parse(saved).isDark;
      } catch(e) {}
      return window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
    }

    var dark = isDark();
    var particleColor = dark
      ? function() {
          var colors = ['99,140,255', '140,110,255', '200,140,230', '130,210,180'];
          return colors[Math.floor(Math.random() * colors.length)];
        }
      : function() {
          var colors = ['37,99,235', '124,58,237', '168,85,247', '59,130,246'];
          return colors[Math.floor(Math.random() * colors.length)];
        };

    if (dark) {
      document.documentElement.style.setProperty('--loader-bg', '#0f0f1a');
      document.documentElement.style.setProperty('--loader-text', '#e0def4');
    }

    // ---- Particles ----
    var particles = [];
    var COUNT = 40;

    for (var i = 0; i < COUNT; i++) {
      particles.push({
        x: Math.random() * W,
        y: Math.random() * H,
        vx: (Math.random() - 0.5) * 0.3,
        vy: (Math.random() - 0.5) * 0.3,
        r: Math.random() * 2 + 0.5,
        color: particleColor(),
        alpha: Math.random() * 0.35 + 0.08
      });
    }

    function drawParticles() {
      ctx.clearRect(0, 0, W, H);

      for (var i = 0; i < particles.length; i++) {
        var p = particles[i];
        p.x += p.vx;
        p.y += p.vy;
        if (p.x < -10) p.x = W + 10;
        if (p.x > W + 10) p.x = -10;
        if (p.y < -10) p.y = H + 10;
        if (p.y > H + 10) p.y = -10;

        ctx.beginPath();
        ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
        ctx.fillStyle = 'rgba(' + p.color + ',' + p.alpha + ')';
        ctx.fill();

        // Subtle connections
        for (var j = i + 1; j < particles.length; j++) {
          var p2 = particles[j];
          var dx = p.x - p2.x;
          var dy = p.y - p2.y;
          var dist = Math.sqrt(dx * dx + dy * dy);
          if (dist < 100) {
            ctx.beginPath();
            ctx.moveTo(p.x, p.y);
            ctx.lineTo(p2.x, p2.y);
            ctx.strokeStyle = 'rgba(' + p.color + ',' + (1 - dist / 100) * 0.06 + ')';
            ctx.lineWidth = 0.5;
            ctx.stroke();
          }
        }
      }

      requestAnimationFrame(drawParticles);
    }
    drawParticles();

    // ---- Block scroll ----
    document.documentElement.style.overflow = 'hidden';

    // ---- Hide loader ----
    function hideLoader() {
      if (loader.classList.contains('hidden')) return;
      loader.classList.add('hidden');
      document.documentElement.style.overflow = '';
      setTimeout(function() {
        if (loader && loader.parentNode) loader.parentNode.removeChild(loader);
      }, 700);
    }

    // Listen for full resource load
    if (document.readyState === 'complete') {
      setTimeout(hideLoader, 400);
    } else {
      window.addEventListener('load', function() {
        setTimeout(hideLoader, 400);
      });
    }

    // Fallback: hide after 6s
    setTimeout(function() {
      if (!loader.classList.contains('hidden')) hideLoader();
    }, 6000);
  })();
  </script>
</div>
