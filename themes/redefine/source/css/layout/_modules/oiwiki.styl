// ============================================================
// OI Wiki 提示框 · 可折叠版（<details class="类型">）
//
// 数值来源：OI Wiki 线上真正加载的 MkDocs Material 样式表
//   https://oi-wiki.org/assets/stylesheets/main.bd3167ff.min.css
//
// 那张表里 1rem = 20px（html{font-size:125%}），.md-typeset 正文 = .8rem = 16px，
// 提示框字号 = .64rem = 12.8px。本站正文同样是 16px、提示框取 0.8em = 12.8px，
// 两者完全对齐，所以下面的 em 是按「相对提示框字号 12.8px」换算出来的：
//
//   Material 原值            本站写法
//   border   .075rem  1.5px  -> 0.1171875em
//   radius   .2rem    4px    -> 0.3125em
//   radius   .1rem    2px    -> 0.15625em
//   padding  .6rem    12px   -> 0.9375em
//   padding  .4rem    8px    -> 0.625em
//   padding  2rem     40px   -> 3.125em
//   padding  1.8rem   36px   -> 2.8125em  （只给 summary：右侧留折叠箭头）
//   icon     1rem     20px   -> 1.5625em
//   ring     .2rem    4px    -> 0.3125em
//   图标/箭头 top  .625em  8px  —— Material 原样就是 em，直接用
//
// 结构由 scripts/modules/oiwiki.js 生成。
// ============================================================


// ------------------------------ 尺寸 ------------------------------
$oiwiki-border       = 0.1171875em   // 1.5px
$oiwiki-radius       = 0.3125em      // 4px
$oiwiki-radius-inner = 0.15625em     // 2px
$oiwiki-pad-x        = 0.9375em      // 12px
// Stylus 不会对 (-$var) 求值，会把 "-$var" 原样吐出来导致整条声明非法，负数单独定义
$oiwiki-pad-x-neg    = -0.9375em     // -12px
$oiwiki-pad-y        = 0.625em       // 8px
$oiwiki-icon         = 1.5625em      // 20px
$oiwiki-icon-top     = 0.625em       // 8px
$oiwiki-title-pad-l  = 3.125em       // 40px
$oiwiki-title-pad-r  = 2.8125em      // 36px
$oiwiki-arrow-right  = 0.625em       // 8px


// ------------------------------ 类型配色 ------------------------------
// 边框取主色、标题条取主色 10%、类型图标取主色、折叠箭头也取主色
oiwiki-color($main-color)
    border-color $main-color

    & > summary
        background-color rgba($main-color, 0.1)

        &::before
            background-color $main-color

        // 箭头跟着主色走 —— 这是 OI Wiki 和普通折叠框最直观的区别
        &::after
            color $main-color

    &:focus-within
        box-shadow 0 0 0 0.3125em rgba($main-color, 0.1)


// ------------------------------ 容器 ------------------------------
.markdown-body
    details.note,
    details.abstract,
    details.info,
    details.tip,
    details.success,
    details.question,
    details.warning,
    details.failure,
    details.danger,
    details.bug,
    details.example,
    details.quote
        background-color var(--background-color)
        border $oiwiki-border solid #448aff
        border-radius $oiwiki-radius
        box-shadow none
        color inherit
        display flow-root
        font-size 0.8em
        line-height 1.6
        margin 1.5625em 0
        padding 0 $oiwiki-pad-x
        page-break-inside avoid
        overflow-wrap break-word
        transition box-shadow 125ms

        & > *
            box-sizing border-box

        // 最后一项的下边距撑出框底留白
        & > :last-of-type
            margin-bottom $oiwiki-pad-x


// ------------------------------ 标题条 ------------------------------
.markdown-body
    details.note,
    details.abstract,
    details.info,
    details.tip,
    details.success,
    details.question,
    details.warning,
    details.failure,
    details.danger,
    details.bug,
    details.example,
    details.quote
        & > summary
            background-color rgba(68, 138, 255, 0.1)
            border none
            border-radius $oiwiki-radius-inner $oiwiki-radius-inner 0 0
            color inherit
            cursor pointer
            display block
            font-weight 700
            line-height 1.6
            // 负 margin 让色条铺满容器 —— OI Wiki 的标志性观感
            margin 0 $oiwiki-pad-x-neg
            min-height $oiwiki-icon
            overflow hidden
            padding $oiwiki-pad-y $oiwiki-title-pad-r $oiwiki-pad-y $oiwiki-title-pad-l
            position relative
            list-style none

            &::-webkit-details-marker
                display none

            &::marker
                display none

            &:not(.focus-visible)
                outline none
                -webkit-tap-highlight-color transparent

            &::before
            &::after
                content ''
                position absolute
                // Material 是从顶部固定 8px，不是垂直居中 —— 标题折行时差别很明显
                top $oiwiki-icon-top
                width $oiwiki-icon
                height $oiwiki-icon
                mask-repeat no-repeat
                mask-position center
                mask-size contain
                -webkit-mask-repeat no-repeat
                -webkit-mask-position center
                -webkit-mask-size contain

            // 类型图标（左）
            &::before
                background-color #448aff
                left $oiwiki-pad-x

            // 折叠箭头（右）
            &::after
                background-color currentcolor
                right $oiwiki-arrow-right
                transform rotate(0deg)
                transition transform 0.25s
                mask-image url('data:image/svg+xml;charset=utf-8,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 24 24%22%3E%3Cpath d=%22M8.59 16.58 13.17 12 8.59 7.41 10 6l6 6-6 6z%22/%3E%3C/svg%3E')
                -webkit-mask-image url('data:image/svg+xml;charset=utf-8,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 24 24%22%3E%3Cpath d=%22M8.59 16.58 13.17 12 8.59 7.41 10 6l6 6-6 6z%22/%3E%3C/svg%3E')

        // 收起状态：标题条四角都收圆
        &:not([open]) > summary
            border-radius $oiwiki-radius-inner

        &[open] > summary::after
            transform rotate(90deg)

        // 主题自带 folding.styl 给 summary 加了灰底 hover，这里压掉
        & > summary:hover
            background-color rgba(68, 138, 255, 0.1)


// ------------------------------ 12 种类型 ------------------------------

