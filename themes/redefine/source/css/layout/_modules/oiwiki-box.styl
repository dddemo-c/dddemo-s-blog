// ============================================================
// OI Wiki 提示框 · 静态 div 版（<div class="admonition 类型">）
//
// 数值同样取自 OI Wiki 线上的 MkDocs Material 样式表
//   https://oi-wiki.org/assets/stylesheets/main.bd3167ff.min.css
// 与同目录 oiwiki.styl 是同一套尺寸，差别只在：
//   · 没有折叠箭头（::after）
//   · 标题条右侧不留箭头位（padding-right 12px，不是 36px）
//   · 没有 summary 的 pointer / min-height / overflow
//
// 官方在 .md-typeset 里把 .admonition 和 details 写在同一组选择器上，
// 所以两种形态除了「能不能折叠」，长得完全一样。
//
// 结构由 scripts/modules/oiwiki-box.js 生成；手写同名 HTML 也走这套样式。
// ============================================================


// ------------------------------ 尺寸 ------------------------------
$admonition-border       = 0.1171875em   // 1.5px
$admonition-radius       = 0.3125em      // 4px
$admonition-radius-inner = 0.15625em     // 2px
$admonition-pad-x        = 0.9375em      // 12px
// Stylus 不会对 (-$var) 求值，会把 "-$var" 原样吐出来导致整条声明非法，负数单独定义
$admonition-pad-x-neg    = -0.9375em     // -12px
$admonition-pad-y        = 0.625em       // 8px
$admonition-icon         = 1.5625em      // 20px
$admonition-icon-top     = 0.625em       // 8px
$admonition-title-pad-l  = 3.125em       // 40px


// ------------------------------ 类型配色 ------------------------------
admonition-color($main-color)
    border-color $main-color

    & > .admonition-title
        background-color rgba($main-color, 0.1)

        &::before
            background-color $main-color

    &:focus-within
        box-shadow 0 0 0 0.3125em rgba($main-color, 0.1)


// ------------------------------ 容器 ------------------------------
.markdown-body
    .admonition
        background-color var(--background-color)
        border $admonition-border solid #448aff
        border-radius $admonition-radius
        box-shadow none
        color inherit
        display flow-root
        font-size 0.8em
        line-height 1.6
        margin 1.5625em 0
        padding 0 $admonition-pad-x
        page-break-inside avoid
        overflow-wrap break-word
        transition box-shadow 125ms

        & > *
            box-sizing border-box

        // 最后一项的下边距撑出框底留白
        & > :last-of-type
            margin-bottom $admonition-pad-x


// ------------------------------ 标题条 ------------------------------
.markdown-body
    .admonition
        & > .admonition-title
            background-color rgba(68, 138, 255, 0.1)
            border none
            border-radius $admonition-radius-inner $admonition-radius-inner 0 0
            color inherit
            font-weight 700
            line-height 1.6
            // 负 margin 让色条铺满容器 —— OI Wiki 的标志性观感
            margin 0 $admonition-pad-x-neg
            padding $admonition-pad-y $admonition-pad-x $admonition-pad-y $admonition-title-pad-l
            position relative

            // 压掉主题给 p 的默认下边距
            &:last-of-type
                margin-bottom 0

            &::before
                content ''
                position absolute
                // Material 是从顶部固定 8px，不是垂直居中
                top $admonition-icon-top
                left $admonition-pad-x
                width $admonition-icon
                height $admonition-icon
                mask-repeat no-repeat
                mask-position center
                mask-size contain
                -webkit-mask-repeat no-repeat
                -webkit-mask-position center
                -webkit-mask-size contain


// ------------------------------ 框套框 ------------------------------
// Material: .admonition .admonition, .admonition details, ... { margin: 1em 0 }
// 用 :is() 一次覆盖两种形态的所有组合，免得写 12×12 条选择器
.markdown-body
    :is(.admonition, details.note, details.abstract, details.info, details.tip, details.success, details.question, details.warning, details.failure, details.danger, details.bug, details.example, details.quote)
        :is(.admonition, details.note, details.abstract, details.info, details.tip, details.success, details.question, details.warning, details.failure, details.danger, details.bug, details.example, details.quote)
            margin-top 1em
            margin-bottom 1em


// ------------------------------ 12 种类型 ------------------------------

