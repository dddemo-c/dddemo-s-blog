// ============================================================================
//  (25) 本地搜索：与全站统一为「浅淡 + 文艺」
//       原样式在 layout/_partials/local-search.styl，这里用同级选择器后置覆盖
// ============================================================================

// 悬停/高亮用的模式感知叠加色（深色模式提亮，浅色模式压暗）
.page-container
  --search-hover rgba(0, 0, 0, 0.045)
  --search-key   rgba(0, 0, 0, 0.07)
  // 毛玻璃面板底色：半透明，让背景透上来与页面融合
  --search-bg    rgba(226, 223, 215, 0.72)
  --search-edge  rgba(255, 255, 255, 0.5)

.dark .page-container
  --search-hover rgba(255, 255, 255, 0.05)
  --search-key   rgba(255, 255, 255, 0.11)
  --search-bg    rgba(14, 17, 24, 0.68)
  --search-edge  rgba(255, 255, 255, 0.09)

.search-pop-overlay
  background rgba(0, 0, 0, 0)
  transition visibility 0.6s ease, background 0.6s ease, backdrop-filter 0.6s ease

  &.active
    background rgba(6, 8, 12, 0.42)
    -webkit-backdrop-filter blur(4px)
    backdrop-filter blur(4px)

  .search-popup
    // 毛玻璃：与背景融合，而不是一块贴在画面上的实色板
    background var(--search-bg)
    -webkit-backdrop-filter blur(28px) saturate(1.3)
    backdrop-filter blur(28px) saturate(1.3)
    border 1px solid var(--search-edge)
    border-radius 22px
    box-shadow 0 40px 100px rgba(0, 0, 0, 0.5),
               0 1px 0 0 rgba(255, 255, 255, 0.06) inset
    height auto
    // ⚠️ Stylus 内置了 min()/max()，会执行掉 CSS 的 min()，必须 unquote
    max-height unquote("min(58vh, 480px)")
    // 小框：只比输入框宽一点，够放几条结果
    width unquote("min(560px, 88vw)")
    overflow hidden
    // 缓慢弹出：0.85s + 轻微回弹
    transform translateY(10px) scale(0.9)
    opacity 0
    transition transform 0.85s cubic-bezier(0.34, 1.3, 0.64, 1),
               opacity 0.55s ease

    +redefine-tablet()
      width unquote("min(520px, 90vw)")

    +redefine-mobile()
      width 92vw
      max-height 66vh

  &.active .search-popup
    transform translateY(0) scale(1)
    opacity 1

  // ---------- 顶部输入区：去掉色带，只留一条极淡的分隔 ----------
  .search-header
    background transparent
    border-radius 0
    padding 1.15rem 1.35rem 0.95rem
    gap 0.8rem
    align-items center
    position relative

    &::after
      content ''
      position absolute
      left 1.35rem
      right 1.35rem
      bottom 0
      height 1px
      background linear-gradient(to right,
        transparent,
        var(--border-color) 15%,
        var(--border-color) 85%,
        transparent)

    .search-input-field-pre
      font-size 1.15rem
      padding 0
      color var(--third-text-color)
      opacity 0.55
      cursor default

    .search-input-container
      flex-grow 1
      padding 0

      .search-input
        background transparent
        border 0
        outline 0
        width 100%
        font-size 1.08rem
        font-weight 300
        letter-spacing 0.04em
        color var(--first-text-color)

        &::placeholder
          color var(--third-text-color)
          opacity 0.5
          letter-spacing 0.14em
          font-weight 300

    .popup-btn-close
      font-size 1.15rem
      padding 0
      color var(--third-text-color)
      opacity 0.55
      transition opacity 0.3s ease, transform 0.35s cubic-bezier(0.22, 0.7, 0.24, 1)

      &:hover
        opacity 1
        transform rotate(90deg)

        .fas, .far, .fab
          color var(--first-text-color)

  // ---------- 结果区 ----------
  #search-result
    display block
    height auto
    max-height calc(min(58vh, 480px) - 3.7rem)
    overflow-y auto
    padding 0.55rem 0.8rem 0.9rem
    scrollbar-width thin
    scrollbar-color var(--border-color) transparent

    &::-webkit-scrollbar
      width 3px

    &::-webkit-scrollbar-thumb
      background var(--border-color)
      border-radius 2px

    .search-result-list
      width 100%
      height auto
      font-size 1rem

      li
        // 原来是一条 dashed 虚线，改为留白 + 圆角悬停
        border-bottom none
        padding 0.85rem 0.75rem
        margin 0 0 0.1rem
        border-radius 10px
        transition background 0.3s ease,
                   padding-left 0.38s cubic-bezier(0.22, 0.7, 0.24, 1)

        &:hover
          background var(--search-hover)
          padding-left 1.25rem

        .search-result-title
          font-weight 500
          font-size 1rem
          letter-spacing 0.02em
          margin-bottom 0.42rem
          padding-left 0
          color var(--first-text-color)
          line-height 1.6

          // 去掉原来的实心小圆点
          &::after
            display none

        .search-result
          line-height 1.8
          margin 0
          padding-left 0
          font-size 0.86rem
          font-weight 300
          color var(--third-text-color)

        a
          &:hover
            color inherit

        // 关键词高亮：柔和的底色块，不用虚线下划线
        .search-keyword
          border-bottom none
          color var(--first-text-color)
          font-weight 500
          background var(--search-key)
          border-radius 3px
          padding 0 2px

    #no-result
      display flex
      align-items center
      justify-content center
      height 100%
      min-height 180px
      color var(--third-text-color)
      opacity 0.3
