      transition border-color 0.35s ease, transform 0.35s cubic-bezier(0.22, 0.7, 0.24, 1)

      &:hover
        border-color var(--second-text-color)
        transform translateY(-2px)

    .credits-patron-card-name
      font-weight 400
      letter-spacing 0.1em

    .credits-patron-card-bio
      color var(--third-text-color)
