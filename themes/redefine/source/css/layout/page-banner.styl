      letter-spacing 0.16em
      color var(--third-text-color)
      opacity 0.8

    .credits-divider
      opacity 0.25

    .credits-heart
      opacity 0.35

    .credits-card
      background transparent !important
      border none
      box-shadow none !important
      padding 1.35rem 0

    .credits-empty
      background transparent !important
      border none
      box-shadow none !important

    .credits-empty-icon
      opacity 0.3

    .credits-empty-text
      font-weight 300
